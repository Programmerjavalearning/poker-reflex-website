# Dependencies
node_modules/
/.pnp
.pnp.js

# Environment variables - CRITICAL
# Catch-all patterns, NOT an enumerated list. A downloaded Vercel env file lands
# as "env.local.download" (no leading dot), which an enumerated list misses and a
# single "git add -A" would then publish to this public repo.
.env
.env.*
*.env
env.local*
*env.local*
*.env.local
!.env.example

# Next.js build output
/.next/
/out/

# Production
/build

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Temporary prompt 
prompt.md

# Claude Code context (private, do not commit)
CLAUDE.md
CLAUDE.local.md